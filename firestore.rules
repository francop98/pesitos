rules_version = '2';
// =========================================================
// Pesitos — reglas de seguridad de Firestore (versión 3: sin cifrado de extremo a extremo)
// Pegalas en Firebase → Firestore Database → Reglas → Publicar.
//
//   usuarios/{uid}           fechas y el PIN de seguridad (solo su hash). Sin nombre ni mail.
//                            'llave' solo existe en cuentas de la versión cifrada hasta que migran.
//   usuarios/{uid}/estado/*  datos de la app: { json, actualizado }. Los documentos viejos
//                            { c, iv } (cifrados) se pueden leer y borrar, pero ya no escribir.
//   usuarios/{uid}/push/*    solo si activás los avisos: la suscripción del
//                            navegador para mandarte notificaciones.
//   usuarios/{uid}/avisos/agenda  solo si activás los avisos: qué días hay algo
//                            (cantidades por día, sin montos, nombres ni comercios).
//   publico/*                promos e inflación: los escribe solo el servidor (Vercel,
//                            con su clave propia); la app los lee por /api/datos.
// Todo lo demás está cerrado. Solo entra una cuenta con el mail verificado
// (las de Google vienen verificadas).
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function pinValido(p) {
      return p is map
        && p.keys().hasOnly(['salt', 'hash', 'largo'])
        && p.salt is string && p.salt.size() < 64
        && p.hash is string && p.hash.size() < 100
        && p.largo is int && p.largo >= 4 && p.largo <= 6;
    }

    match /usuarios/{uid} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['creado', 'ultimoIngreso', 'llave', 'pin'])
        // la llave vieja no se puede crear ni cambiar: solo queda o se borra
        && (!('llave' in request.resource.data) || (resource != null && 'llave' in resource.data && request.resource.data.llave == resource.data.llave))
        && (!('pin' in request.resource.data) || pinValido(request.resource.data.pin));

      match /estado/{docId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && docId.matches('^(general|(expenses|incomes|transfers)-([0-9]{4}|sin-fecha))(~[0-9]{1,2})?$')
          && request.resource.data.keys().hasOnly(['json', 'actualizado'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 1000000;
      }

      match /push/{subId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && subId.matches('^[0-9a-f]{24}$')
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'creado'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('^https://.{10,900}$')
          && request.resource.data.keys is map
          && request.resource.data.keys.keys().hasOnly(['p256dh', 'auth'])
          && request.resource.data.keys.p256dh is string && request.resource.data.keys.p256dh.size() < 200
          && request.resource.data.keys.auth is string && request.resource.data.keys.auth.size() < 100;
      }

      match /avisos/{docId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid)
          && docId == 'agenda'
          && request.resource.data.keys().hasOnly(['dias', 'actualizado'])
          && request.resource.data.dias is map
          && request.resource.data.dias.size() <= 60;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
